#
# voice-cli: the command line backend of the uvoice stack.
#
# The command set is the one that /usr/srg/scripts/voip_cli.sh gives the other
# voice stack, so a single klish tree drives either stack through
# voip-cli-dispatch. The commands that only the other stack serves answer one
# line and exit 1: the log module and preset tables, and the SLIC register and
# RAM dumps. The views this stack owns alone (the daemon, the line, the
# account table, the call table, the line monitor and the call records) render
# through /usr/share/uvoice/uvoice-cli.uc, the formatter behind uvoice.sh, so
# the two surfaces share one renderer.
#
# The CLI is 1 based and the ubus surface is 0 based. The single decrement of
# the whole script lives in line_index_get(). The formatter prints its line
# numbers 1 based too, through UVOICE_LINE_BASE=1 in formatter_run().

prog=voice-cli
uvoice_init=/etc/init.d/uvoice
ubus_timeout=5
ubus_object=voice
# The client outlives the daemon's live query backstop so the daemon reports a
# query that never completes.
ubus_live_timeout=10
# The client outlives the daemon's line test budget so the daemon reports a
# test that never completes.
ubus_line_test_timeout=110
log_tag=uvoice
# The daemon writes the key log to SIP_TLS_KEYLOG_DEFAULT
# (src/proto/sip/tls.h), and uvoice_tls_cert.sh writes the certificate
# status to its TLS_STATUS.
tls_keylog=${UVOICE_TLS_KEYLOG:-/tmp/uvoice/ssl.keylog}
tls_status=${UVOICE_TLS_STATUS:-/tmp/voip_tls_stat.txt}

#
# The line state vocabulary of the arc.voip handler,
# /usr/share/rpcd/ucode/voip.uc. The CLI and
# the web page must name a line state with the same word, so both read one
# table set. run_cli_tests.sh parses the "key=value" entries out of both files
# and fails when they drift, which is why every table stays on one line in this
# "|" separated form.
#
sip_client_status_map='registered=Up|refreshing=Up|resolving=Registering|trying=Registering|backoff=Error_Registration|unregistered=Quiescent'
line_call_status_map='IDLE=Idle|OFFHOOK_DIAL=Dialing|COLLECTING=Dialing|SPRE_COLLECT=Dialing|CALLING=Alerting|PROCEEDING=Delivered|CONNECTED=Connected|RINGING=Alerting|CW_OFFERED=Connected|HOLD_DIAL=Dialing|TWO_CALLS=Connected|CONF=Connected|PENDING=Connected|HOLDING=Connected|CLEARING=Disconnected|ROH=Disconnected|OOS=Idle|XFER_COLLECT=Dialing'
line_detailed_status_map='IDLE=Idle|OFFHOOK_DIAL=Dial tone|COLLECTING=Digit collection|SPRE_COLLECT=Digit collection|CALLING=Trying|PROCEEDING=Ringback|CONNECTED=Connected|RINGING=Alerting|CW_OFFERED=Special tone|HOLD_DIAL=Dial tone|TWO_CALLS=Connected|CONF=Connected|PENDING=Connected|HOLDING=Connected|CLEARING=Disconnected|ROH=Receiver offhook warning|OOS=Idle|XFER_COLLECT=Digit collection'
clearing_status_map='busy=Busy|fastbusy=Fast busy|unobtainable=Fast busy|quiet=Silent offhook'
hook_state_map='IDLE=Onhook|RINGING=Onhook|HOLDING=Onhook|OFFHOOK_DIAL=Offhook|COLLECTING=Offhook|SPRE_COLLECT=Offhook|CALLING=Offhook|PROCEEDING=Offhook|CONNECTED=Offhook|CW_OFFERED=Offhook|HOLD_DIAL=Offhook|TWO_CALLS=Offhook|CONF=Offhook|PENDING=Offhook|CLEARING=Offhook|ROH=Offhook|XFER_COLLECT=Offhook|OOS=Disabled'

#
# The MGCP endpoint states, mapped to the same row words. The arc.voip handler
# has no MGCP tables, so the parity check does not read these.
#
mgcp_line_call_status_map='idle=Idle|offhook=Dialing|ringing=Alerting|connected=Connected|restarting=Idle|out_of_service=Idle|down=Idle'
mgcp_line_detailed_status_map='idle=Idle|offhook=Dial tone|ringing=Alerting|connected=Connected|restarting=Idle|out_of_service=Idle|down=Idle'
mgcp_hook_state_map='idle=Onhook|ringing=Onhook|offhook=Offhook|connected=Offhook|restarting=Disabled|out_of_service=Disabled|down=Disabled'

usage_show() {
	cat <<'EOF'
usage:
voice-cli <cmd> [arg1] [arg2] [arg3]

cmd: start|stop|restart|seize|release|dial|stats_live|line_test|looptest|
     calltrace|show|set|apply

start: start the uvoice daemon
stop: stop the uvoice daemon
restart: stop and start the uvoice daemon

seize <line>: seize line (offhook), lines count from 1
release <line>: release line (onhook), lines count from 1
dial <line> <number>: dial on line, lines count from 1

stats_live <line> [slot]: live media counters of a running call, lines count from 1
   slot: the 0 based slot voice status reports, omit it when the line holds one call
line_test <line> <test>: metallic test; choose gr909, roh, capacitance or loop
looptest start|stop: the manufacturing loop test on every line; each line
   rings, a lifted handset hears its own voice back or the other line, and
   every line is out of service until the test stops

calltrace arm <line> [timeout]: trace the next call, lines count from 1
calltrace status: trace state, readiness, and archive
calltrace cancel: cancel the active trace
calltrace wait: wait for an archive; the wait deadline exits 2

show: show voip information
   arg1: <config|version|global|channel1|channel2|daemon|lines|calls|monitor|
          cdr|status|statistics|log|raw>
   global [field]: the loaded configuration, or one uci option
   channelN [config|field]: the line view, its loaded configuration, or one
          uci option
   daemon: the daemon summary; lines: the account table; calls: the call
          table; monitor: the line monitor table
   cdr [last N|seq N]: the call records, the last N, or one record in full
   statistics [line N|live N [slot]]: the per line counters, or the live
          media of a running call

set: set a parameter
   arg1: <global|line|profile>

apply: apply a profile to a line
   arg1: profile   arg2: <profile name>   arg3: <line reference>
EOF
}

fail() {
	# A half staged change must not survive: the next command that
	# succeeds would commit it along with its own.
	[ -n "$uci_staged" ] && uci revert voip 2>/dev/null

	printf '%s: %s\n' "$prog" "$*" >&2
	exit 1
}

unsupported() {
	printf '%s: %s: not supported on the uvoice stack\n' "$prog" "$*" >&2
	exit 1
}

#
# Walk a "key=value|key=value" table without word splitting, so the script
# needs no IFS games and stays clean under shellcheck.
#
map_get() {
	map_rest=$1
	map_key=$2
	map_value=$3

	while [ -n "$map_rest" ]; do
		map_entry=${map_rest%%|*}
		case $map_rest in
		*'|'*) map_rest=${map_rest#*|} ;;
		*) map_rest='' ;;
		esac

		case $map_entry in
		"$map_key="*)
			map_value=${map_entry#*=}
			break
			;;
		esac
	done

	printf '%s\n' "$map_value"
}

uint_check() {
	case $1 in
	'' | *[!0-9]*) return 1 ;;
	esac

	# A value too wide for the shell integer makes "test" and "$(( ))"
	# print an arithmetic error of their own before the caller reaches its
	# named refusal, so the width is bounded here and nowhere else. The
	# bound reads the raw text, ahead of any uint_normalize(), so a wide run
	# of leading zeros is refused and not narrowed into range.
	[ "${#1}" -le 9 ] || return 1

	return 0
}

#
# A leading zero is decimal to the person who typed it and octal to the shell:
# "$(( ))" reads 010 as 8 and refuses 08 outright, and 007 is not a json number
# to RFC 8259 (json-c tolerates it, a strict parser refuses it). uint_check()
# stays the validity gate; every consumer whose value
# reaches arithmetic or the hand built json normalizes it here first.
#
uint_normalize() {
	norm_digits=${1#"${1%%[!0]*}"}

	printf '%s\n' "${norm_digits:-0}"
}

#
# The dial alphabet of line_inject_dial(), mirrored on this side of ubus
# (diag-verbs: empty, over long or not dialable is refused). This script builds
# the ubus json by hand, so a number carrying a quote could otherwise close the
# "number" string and add keys of its own; a second "line" key would win and
# the daemon would drive a line the caller never named. Refusing every
# character outside the dial alphabet closes that whole class here, before any
# ubus call is made.
#
dial_number_check() {
	case $1 in
	'') return 1 ;;
	*[!0-9*#]*) return 1 ;;
	esac

	[ "${#1}" -le 32 ] || return 1

	return 0
}

# The one place the 1 based CLI meets the 0 based ubus surface.
line_index_get() {
	uint_check "$1" || return 1

	line_index_value=$(uint_normalize "$1")
	[ "$line_index_value" -ge 1 ] || return 1

	printf '%s\n' "$((line_index_value - 1))"
}

ubus_call() {
	ubus_call_method=$1
	shift
	ubus_call_line=''
	if [ "$ubus_call_method" = line_test ]; then
		ubus_call_line=$1
		shift
	fi

	ubus_call_out=$(ubus -t "$ubus_timeout" call "$ubus_object" \
		"$ubus_call_method" "$@" 2>&1)
	ubus_call_rc=$?
	if [ "$ubus_call_rc" -ne 0 ]; then
		if [ "$ubus_call_method" = line_test ] &&
			line_test_error_show "$ubus_call_rc" "$ubus_call_line"; then
			return 1
		fi
		if [ "$ubus_call_method" = loop_test ] &&
			looptest_error_show "$ubus_call_rc"; then
			return 1
		fi
		printf '%s: %s %s failed: %s\n' "$prog" "$ubus_object" \
			"$ubus_call_method" \
			"$(printf '%s\n' "$ubus_call_out" | sed -n 1p)" >&2
		return 1
	fi

	printf '%s\n' "$ubus_call_out"
}

#
# The formatter behind uvoice.sh renders the views this stack owns alone. It
# prints its own refusal line, so the exit status is all this side reads. The
# color word follows _uvoice_table() in uvoice.sh: on for a terminal, which is
# what a klish ACTION runs on, plain for a pipe or a capture.
#
formatter_run() {
	formatter_color=${UVOICE_COLOR:-}
	if [ -z "$formatter_color" ] && [ -t 1 ]; then
		formatter_color=1
	fi

	UVOICE_COLOR="$formatter_color" UVOICE_LINE_BASE=1 UVOICE_HINT_STYLE=klish \
		UVOICE_UBUS_SOCKET="${UVOICE_UBUS_SOCKET:-}" \
		ucode "${UVOICE_CLI:-/usr/share/uvoice/uvoice-cli.uc}" -- "$@"
}

calltrace_reply_show() {
	printf '%s' "$1" | jq -r '
		if has("line") then "line \(.line + 1) (index \(.line))"
		else empty end'
	printf '%s\n' "$1"
}

calltrace_run() {
	trace_method=${1:-}
	if [ "$trace_method" = wait ]; then
		formatter_run calltrace_wait
		return
	fi
	trace_args='{}'
	case "$trace_method" in
	arm)
		trace_index=$(line_index_get "${2:-}") ||
			fail 'calltrace arm: a line number is required, lines count from 1'
		trace_args="{\"line\":$trace_index"
		if [ -n "${3:-}" ]; then
			uint_check "$3" || fail 'calltrace arm: timeout must be seconds'
			trace_args="$trace_args,\"timeout\":$(uint_normalize "$3")"
		fi
		trace_args="$trace_args}"
		;;
	status | cancel) ;;
	*) fail 'calltrace: expected arm, status, cancel, or wait' ;;
	esac
	ubus_object=voice.calltrace
	if ! trace_reply=$(ubus_call "$trace_method" "$trace_args"); then
		trace_reply=$(ubus_call status '{}') && calltrace_reply_show "$trace_reply"
		return 1
	fi
	calltrace_reply_show "$trace_reply"
}

line_test_error_show() {
	# The captured stderr is not a terminal, so the client negates statuses and
	# treats -2 as a usage error.
	case $1 in
	2 | 254)
		line_test_error='the line or test is not known to the daemon'
		;;
	4 | 252)
		if ! ubus -t 2 list voice >/dev/null 2>&1; then
			printf '%s: the voice daemon does not answer ubus\n' "$prog" >&2
			return 0
		fi
		line_test_error="line $2 is not configured"
		;;
	5 | 251)
		line_test_error="line $2 is down, busy with a call or a test, or the \
backend has no line test"
		;;
	7 | 249)
		line_test_error="line $2 test timed out in the daemon"
		;;
	9 | 247)
		line_test_error='the backend failed the test or the record is unreadable'
		;;
	*)
		return 1
		;;
	esac

	printf '%s: line_test: %s\n' "$prog" "$line_test_error" >&2
	return 0
}

# The refusals of the loop test, in the shape above. The mode takes the whole
# board, so no refusal names a line.
looptest_error_show() {
	case $1 in
	2 | 254)
		looptest_error='a value is out of range, or the mode is not self or cross'
		;;
	4 | 252)
		if ! ubus -t 2 list voice >/dev/null 2>&1; then
			printf '%s: the voice daemon does not answer ubus\n' "$prog" >&2
			return 0
		fi
		looptest_error='this board carries no line'
		;;
	5 | 251)
		looptest_error="the dsp is not ready, a call or a line test is \
running, or the backend carries no loop"
		;;
	9 | 247)
		looptest_error='the daemon refused the loop test'
		;;
	*)
		return 1
		;;
	esac

	printf '%s: looptest: %s\n' "$prog" "$looptest_error" >&2
	return 0
}

voice_status_get() {
	status_json=$(ubus -t "$ubus_timeout" call voice status 2>/dev/null)
	if [ -z "$status_json" ]; then
		printf '%s: the voice daemon does not answer ubus\n' "$prog" >&2
		return 1
	fi

	printf '%s\n' "$status_json"
}

# The line span of the arc.voip handler: the configured channel count widened
# by any index the daemon actually reports.
line_span_get() {
	printf '%s' "$1" | jq -r '
		[ (.config.channels // 0) ]
		+ [ ((.lines // [])[] | .line + 1) ]
		+ [ ((.call // [])[] | .line + 1) ]
		| max'
}

uci_channels_get() {
	uci_channels=$(uci -q get voip.base.channels)
	uint_check "$uci_channels" || uci_channels=0

	printf '%s\n' "$uci_channels"
}

#
# Commands
#

voice_service() {
	[ -x "$uvoice_init" ] || fail "$uvoice_init is not present"

	"$uvoice_init" "$1"
}

voice_cmd() {
	cmd_action=$1
	cmd_line=$2
	cmd_number=$3

	cmd_index=$(line_index_get "$cmd_line") ||
		fail "$cmd_action: line \"$cmd_line\" is not a line number, lines count from 1"

	case $cmd_action in
	seize | release)
		ubus_call "$cmd_action" "{\"line\":$cmd_index}" >/dev/null || return 1
		;;
	dial)
		[ -n "$cmd_number" ] || fail "dial: not enough arguments; dial <line> <number>"
		dial_number_check "$cmd_number" ||
			fail "dial: number \"$cmd_number\" is not dialable; 1 to 32 characters from 0-9, * and #"
		printf 'Dialing %s\n' "$cmd_number"
		ubus_call dial "{\"line\":$cmd_index,\"number\":\"$cmd_number\"}" >/dev/null ||
			return 1
		;;
	esac

	return 0
}

#
# The live per-call media query. It names a leg and not a line, so the CLI
# needs the call slot as well: voice status carries one entry per line and a
# "calls" array inside it, one entry per slot the line holds, and that array is
# where an omitted slot comes from. The daemon owns every refusal, so a bad
# slot travels to it untouched and its answer is what the caller reads.
#
# The slot the query names is the UI one. A line that carried a transfer holds
# legs whose physical slot and UI slot differ, and the daemon looks the query
# up by the UI name (src/proto/sip/call.h, call_slot_stream); "slot" beside it
# is the physical index every other key of the entry describes.
#

# Sets live_slot from the single call the line owns.
stats_live_slot_resolve() {
	resolve_line=$1
	resolve_index=$2
	resolve_count=0
	resolve_names=''

	resolve_status=$(voice_status_get) || return 1

	# A shadow leg is not a call the subscriber has. During a transfer a
	# line carries two legs under one name: the leg being handed over and
	# the one taking it. Only the owner speaks for the name, and the daemon
	# answers the query for that one, so counting both would refuse a line
	# that holds exactly one call and ask for a slot nobody can give.
	#
	# The loop takes its input from a here document and not a pipe, so the
	# slot it finds survives into the caller.
	while read -r resolve_entry_slot resolve_entry_state; do
		[ -n "$resolve_entry_slot" ] || continue

		resolve_count=$((resolve_count + 1))
		live_slot=$resolve_entry_slot
		resolve_names="${resolve_names:+$resolve_names, }slot $resolve_entry_slot ($resolve_entry_state)"
	done <<EOF
$(printf '%s' "$resolve_status" | jq -r --argjson idx "$resolve_index" '
	((.call // []) | map(select(.line == $idx)))[0]
	| ((.calls // []) | map(select(.shadow != true))[]
	   | "\(.ui_slot) \(.state // "?")")')
EOF

	[ "$resolve_count" -ne 0 ] || fail "stats_live: line $resolve_line has no call"
	[ "$resolve_count" -eq 1 ] ||
		fail "stats_live: line $resolve_line carries $resolve_count calls: $resolve_names; name the slot"
}

stats_live_render() {
	live_json=$1

	{
		read -r live_reply_line
		read -r live_reply_slot
	} <<EOF
$(printf '%s' "$live_json" | jq -r '[ (.line // 0), (.slot // 0) ] | .[]')
EOF

	# The header arithmetic runs on a value the daemon chose, and the shell
	# answers a non numeric one with a diagnostic of its own and exit 2,
	# which loses both the exit 1 contract and any word about the daemon. A
	# leading zero reads as octal in that same arithmetic, so the gate is
	# followed by the normalization the request side uses.
	uint_check "$live_reply_line" ||
		fail "stats_live: the daemon answered line \"$live_reply_line\", which is not a line number"
	live_reply_line=$(uint_normalize "$live_reply_line")

	printf 'Line %s slot %s\n' "$((live_reply_line + 1))" "$live_reply_slot"

	while read -r live_key live_value; do
		[ -n "$live_key" ] || continue

		printf '   %-25s%s\n' "$live_key" "$live_value"
	done <<EOF
$(printf '%s' "$live_json" | jq -r '(.media // {}) | to_entries[] | "\(.key) \(.value)"')
EOF

	printf '\n'
}

stats_live_show() {
	live_line=$1
	live_slot=$2

	live_index=$(line_index_get "$live_line") ||
		fail "stats_live: line \"$live_line\" is not a line number, lines count from 1"

	if [ -n "$live_slot" ]; then
		uint_check "$live_slot" ||
			fail "stats_live: slot \"$live_slot\" is not a slot number, slots count from 0"
	else
		stats_live_slot_resolve "$live_line" "$live_index" || return 1
		# The resolved slot is interpolated into the ubus json this script
		# builds by hand, exactly like the dialled number is, so it passes
		# a gate of the same kind: a status entry carrying a crafted slot
		# would otherwise close the "slot" value and add keys of its own,
		# and a status entry carrying no slot at all would send "null".
		uint_check "$live_slot" ||
			fail "stats_live: the daemon reported slot \"$live_slot\", which is not a slot number"
	fi

	# Both paths reach the hand built json in one shape: a daemon never
	# reports a leading zero, and the caller who types one means the decimal
	# slot, which is what a json number can carry.
	live_slot=$(uint_normalize "$live_slot")

	# The client must outlive the daemon's own 5 s backstop, so that a query
	# the DSP never completes is reported by the daemon that knows why and
	# not by a client timeout that does not.
	ubus_timeout=$ubus_live_timeout

	live_reply=$(ubus_call stats_live "{\"line\":$live_index,\"slot\":$live_slot}") ||
		return 1

	stats_live_render "$live_reply"
}

line_test_render() {
	line_test_json=$1
	line_test_status=$(printf '%s' "$line_test_json" |
		jq -r 'if (.status | type) == "string" then .status else "" end' \
			2>/dev/null) || line_test_status=''
	case $line_test_status in
	complete|failed|malformed) ;;
	*) fail 'line_test: the daemon answered no known status' ;;
	esac

	printf 'status=%s\n' "$line_test_status"
	case $line_test_status in
	complete)
		printf '%s' "$line_test_json" | jq -r '
			(.record // {}) | to_entries[]
			| select(.key != "version" and .key != "test_id" and
			         .key != "code" and .key != "valid")
			| "\(.key)=\(.value)"'
		;;
	failed)
		printf '%s' "$line_test_json" | jq -r '"code=\(.code)"'
		;;
	malformed)
		printf '%s' "$line_test_json" | jq -r '"length=\(.length)"'
		;;
	esac
}

line_test_show() {
	line_test_line=$1
	line_test_name=$2

	line_test_index=$(line_index_get "$line_test_line") ||
		fail "line_test: line \"$line_test_line\" is not a line number," \
			'lines count from 1'

	case $line_test_name in
	gr909 | roh | capacitance | loop) ;;
	*)
		fail "line_test: test \"$line_test_name\" is not known;" \
			'expected gr909, roh, capacitance or loop'
		;;
	esac

	ubus_timeout=$ubus_line_test_timeout
	line_test_reply=$(ubus_call line_test "$line_test_line" \
		"{\"line\":$line_test_index,\"test\":\"$line_test_name\"}") ||
		return 1

	line_test_render "$line_test_reply"
}

looptest_render() {
	printf '%s' "$1" | jq -r '
		"enabled=\(.enabled)", "mode=\(.mode)", "lines=\(.lines)",
		"ring_s=\(.ring_s)", "delay_ms=\(.delay_ms)"'
}

looptest_show() {
	case ${1:-} in
	start)
		looptest_args='{"enable":true}'
		;;
	stop)
		looptest_args='{"enable":false}'
		;;
	*)
		fail 'looptest: expected start or stop'
		;;
	esac

	looptest_reply=$(ubus_call loop_test "$looptest_args") || return 1

	looptest_render "$looptest_reply"
}

line_status_show() {
	status_line_json=$1
	status_line_index=$2

	{
		read -r signaling_sip
		read -r signaling_mgcp
		read -r acct_present
		read -r acct_state
		read -r acct_entity
		read -r acct_service
		read -r call_state
		read -r call_clearing
	} <<EOF
$(printf '%s' "$status_line_json" | jq -r --argjson idx "$status_line_index" '
	((.lines // []) | map(select(.line == $idx)))[0] as $acct
	| ((.call // []) | map(select(.line == $idx)))[0] as $call
	| [ (if .signaling.protocol == "sip" and .signaling.state == "running"
	     then "1" else "0" end),
	    (if .signaling.protocol == "mgcp" and .signaling.state == "running"
	     then "1" else "0" end),
	    (if $acct then "1" else "0" end),
	    ($acct.state // ""),
	    ($acct.notified_entity // ""),
	    ($acct.service // ""),
	    ($call.state // ""),
	    ($call.clearing // "") ]
	| .[]')
EOF

	if [ "$acct_present" = 1 ]; then
		sip_status=$(map_get "$sip_client_status_map" "$acct_state" Unknown)
	else
		sip_status=Disabled
	fi

	call_map=$line_call_status_map
	detailed_map=$line_detailed_status_map
	hook_map=$hook_state_map
	if [ "$signaling_mgcp" = 1 ]; then
		call_map=$mgcp_line_call_status_map
		detailed_map=$mgcp_line_detailed_status_map
		hook_map=$mgcp_hook_state_map
	fi

	if [ "$call_state" = CLEARING ]; then
		detailed=$(map_get "$clearing_status_map" "$call_clearing" \
			"$(map_get "$detailed_map" CLEARING Unknown)")
	else
		detailed=$(map_get "$detailed_map" "$call_state" Unknown)
	fi

	printf 'Line %s\n' "$((status_line_index + 1))"
	# The row maps a SIP registration state, so a daemon that runs no SIP
	# table has none to show.
	if [ "$signaling_sip" = 1 ]; then
		printf '   %-24s%s\n' 'SIP client status' "$sip_status"
	fi
	# An MGCP endpoint has a notified entity and a service state instead.
	if [ "$signaling_mgcp" = 1 ]; then
		printf '   %-24s%s\n' 'MGCP call agent' \
			"${acct_entity:-none} (${acct_service:-no endpoint})"
	fi
	printf '   %-24s%s\n' 'Hook status' "$(map_get "$hook_map" "$call_state" Unknown)"
	printf '   %-24s%s\n' 'Call status' "$(map_get "$call_map" "$call_state" Unknown)"
	printf '   %-24s%s\n' 'Call detailed status' "$detailed"
	printf '\n'
}

line_statistics_show() {
	stats_line_json=$1
	stats_line_index=$2

	{
		read -r packets_sent
		read -r packets_recv
		read -r packets_lost
		read -r bytes_sent
		read -r bytes_recv
		read -r in_received
		read -r in_answered
		read -r in_failed
		read -r out_attempted
		read -r out_answered
		read -r out_failed
	} <<EOF
$(printf '%s' "$stats_line_json" | jq -r --argjson idx "$stats_line_index" '
	((.stats // []) | map(select(.line == $idx)))[0] as $s
	| [ ($s.totals.packets_sent // 0), ($s.totals.packets_recv // 0),
	    ($s.totals.packets_lost // 0), ($s.totals.bytes_sent // 0),
	    ($s.totals.bytes_recv // 0),
	    ($s.in_received // 0), ($s.in_answered // 0), ($s.in_failed // 0),
	    ($s.out_attempted // 0), ($s.out_answered // 0), ($s.out_failed // 0) ]
	| .[]')
EOF

	printf 'Line %s\n' "$((stats_line_index + 1))"
	printf '   %-25s%s\n' 'Packets sent' "$packets_sent"
	printf '   %-25s%s\n' 'Packets received' "$packets_recv"
	printf '   %-25s%s\n' 'Packets lost' "$packets_lost"
	printf '   %-25s%s\n' 'Bytes sent' "$bytes_sent"
	printf '   %-25s%s\n' 'Bytes received' "$bytes_recv"
	printf '   %-25s%s\n' 'Incoming calls received' "$in_received"
	printf '   %-25s%s\n' 'Incoming calls connected' "$in_answered"
	printf '   %-25s%s\n' 'Incoming calls failed' "$in_failed"
	printf '   %-25s%s\n' 'Outgoing calls attempted' "$out_attempted"
	printf '   %-25s%s\n' 'Outgoing calls connected' "$out_answered"
	printf '   %-25s%s\n' 'Outgoing calls failed' "$out_failed"
	printf '\n'
}

# "status" takes an optional "line <n>" selector, the shape the klish show
# ACTION builds.
line_range_run() {
	range_render=$1
	range_json=$2
	range_selector=$3
	range_line=$4

	range_span=$(line_span_get "$(voice_status_get)") || return 1
	uint_check "$range_span" || range_span=0

	if [ "$range_selector" = line ]; then
		range_index=$(line_index_get "$range_line") ||
			fail "line \"$range_line\" is not a line number, lines count from 1"
		[ "$range_index" -lt "$range_span" ] ||
			fail "line $range_line: this stack carries $range_span line(s)"
		"$range_render" "$range_json" "$range_index"
		return 0
	fi

	[ -z "$range_selector" ] || fail "invalid argument \"$range_selector\"; expected \"line\""

	range_index=0
	while [ "$range_index" -lt "$range_span" ]; do
		"$range_render" "$range_json" "$range_index"
		range_index=$((range_index + 1))
	done
}

# The line_range_run shape with the daemon doing the line filtering: the span
# and the friendly refusals still resolve first, from voice status, so a bad
# selector never reaches the daemon and its refusal text. "live" hands the
# line and the slot to the live media query, which carries its own refusals.
stats_show() {
	stats_selector=$1
	stats_line=$2
	stats_slot=$3

	if [ "$stats_selector" = live ]; then
		stats_live_show "$stats_line" "$stats_slot"
		return
	fi

	stats_span=$(line_span_get "$(voice_status_get)") || return 1
	uint_check "$stats_span" || stats_span=0

	if [ "$stats_selector" = line ]; then
		stats_index=$(line_index_get "$stats_line") ||
			fail "line \"$stats_line\" is not a line number, lines count from 1"
		[ "$stats_index" -lt "$stats_span" ] ||
			fail "line $stats_line: this stack carries $stats_span line(s)"
		stats_json=$(ubus_call stats "{\"line\":$stats_index}") || return 1
		line_statistics_show "$stats_json" "$stats_index"
		return 0
	fi

	[ -z "$stats_selector" ] ||
		fail "invalid argument \"$stats_selector\"; expected \"line\" or \"live\""

	stats_json=$(ubus_call stats) || return 1
	stats_index=0
	while [ "$stats_index" -lt "$stats_span" ]; do
		line_statistics_show "$stats_json" "$stats_index"
		stats_index=$((stats_index + 1))
	done
}

log_follow_wait() {
	# klish blocks SIGINT, SIGQUIT and SIGHUP for an ACTION child
	# (clish_shell_exec_action()), so Ctrl-C cannot end a follow from the
	# CLI, so a keypress ends it.
	if [ ! -t 0 ]; then
		wait
		return 0
	fi

	stty_saved=$(stty -g)
	stty raw -echo
	dd bs=1 count=1 >/dev/null 2>&1
	stty "$stty_saved"
}

log_show() {
	log_follow=''
	log_match=''
	log_match_started=''

	# Consume our own options and rotate everything else back into "$@",
	# which then holds the logread pass through arguments alone.
	log_argc=$#
	log_seen=0
	while [ "$log_seen" -lt "$log_argc" ]; do
		log_arg=$1
		shift
		log_seen=$((log_seen + 1))

		case $log_arg in
		-f)
			log_follow=1
			log_match_started=''
			;;
		-m)
			log_match_started=1
			;;
		-*)
			log_match_started=''
			set -- "$@" "$log_arg"
			;;
		*)
			if [ -n "$log_match_started" ]; then
				if [ -n "$log_match" ]; then
					log_match="$log_match $log_arg"
				else
					log_match=$log_arg
				fi
			else
				set -- "$@" "$log_arg"
			fi
			;;
		esac
	done

	# The read is captured so that its exit status is the one reported: in a
	# pipeline it would be grep's, and grep answers 1 for "nothing matched",
	# which is not a failure to read the log.
	if ! log_text=$(logread -e "$log_tag" "$@"); then
		printf '%s: logread failed\n' "$prog" >&2
		return 1
	fi

	if [ -n "$log_match" ]; then
		[ -z "$log_text" ] || printf '%s\n' "$log_text" | grep -- "$log_match"
	else
		[ -z "$log_text" ] || printf '%s\n' "$log_text"
	fi

	[ -n "$log_follow" ] || return 0

	if [ -n "$log_match" ]; then
		logread -e "$log_tag" -f "$@" | grep -- "$log_match" &
	else
		logread -e "$log_tag" -f "$@" &
	fi
	log_pid=$!

	log_follow_wait
	# The pipeline reports the pid of grep; killing it breaks the pipe and
	# logread leaves on the next write.
	kill "$log_pid" 2>/dev/null
	wait "$log_pid" 2>/dev/null

	return 0
}

raw_show() {
	raw_status=$(voice_status_get) || return 1

	printf 'VoIP Status\n'
	printf -- '-----------\n'
	printf '%s\n' "$raw_status" | jq .
	printf '\n'
	printf 'VoIP Statistics\n'
	printf -- '---------------\n'
	ubus_call stats | jq .
	printf '\n'
	printf 'VoIP Call Records\n'
	printf -- '-----------------\n'
	ubus_call cdr | jq .
	printf '\n'
	printf 'VoIP Loaded Config\n'
	printf -- '------------------\n'
	ubus_call dump_config | jq .
	printf '\n'
	printf 'VoIP Parameters\n'
	printf -- '---------------\n'
	uci show voip
}

version_show() {
	version_status=$(voice_status_get) || return 1

	{
		read -r ver_daemon
		read -r ver_backend
		read -r ver_hal
		read -r ver_slic
		read -r ver_features
		read -r ver_codecs
	} <<EOF
$(printf '%s' "$version_status" | jq -r '
	[ (.version // "unknown"), (.hal.backend // "unknown"),
	  (.hal.version // "unknown"), (.hal.slic // "unknown"),
	  ((.hal.features // []) | join(",")),
	  ((.hal.codecs // []) | join(",")) ] | .[]')
EOF
	ver_sample_rate=$(uci -q get voip.hal.sample_rate)
	[ -n "$ver_sample_rate" ] || ver_sample_rate=8000
	case ",$ver_features," in
	*,wideband,*) ver_hal_sample_rate=16000 ;;
	*) ver_hal_sample_rate=8000 ;;
	esac

	printf '%-19s%s\n' 'Version' "$ver_daemon"
	printf '%-19s%s\n' 'HAL backend' "$ver_backend"
	printf '%-19s%s\n' 'HAL version' "$ver_hal"
	printf '%-19s%s\n' 'SLIC' "$ver_slic"
	printf '%-19s%s\n' 'HAL features' "$ver_features"
	printf '%-19s%s\n' 'HAL codecs' "$ver_codecs"
	printf '%-24s%s\n' 'Configured sample rate' "$ver_sample_rate"
	printf '%-24s%s\n' 'HAL sample rate' "$ver_hal_sample_rate"
}

channel_show() {
	channel_ref=$1
	channel_field=$2
	channel_number=${channel_ref#channel}

	if uint_check "$channel_number"; then
		channel_count=$(uci_channels_get)
		if [ "$channel_count" -gt 0 ] && [ "$channel_number" -gt "$channel_count" ]; then
			fail "show: invalid channel $channel_number"
		fi
	fi

	# A named option keeps the uci lookup, which scripts read one value
	# through; the section itself renders as the line view, and the word
	# config as its loaded configuration.
	case $channel_field in
	'' | config)
		channel_index=$(line_index_get "$channel_number") ||
			fail "show: invalid channel $channel_number"
		;;
	esac

	case $channel_field in
	'') formatter_run line --line "$channel_index" ;;
	config) formatter_run config --channel "$channel_index" ;;
	*) uci show "voip.$channel_ref.$channel_field" ;;
	esac
}

# "cdr" takes "last N" or "seq N", the shape the klish call-records ACTION
# builds.
cdr_show() {
	cdr_selector=$1
	cdr_value=$2

	case $cdr_selector in
	'')
		formatter_run cdr
		return
		;;
	last | seq) ;;
	*)
		fail "show cdr: invalid argument \"$cdr_selector\"; expected \"last\" or \"seq\""
		;;
	esac

	uint_check "$cdr_value" ||
		fail "show cdr $cdr_selector: \"$cdr_value\" is not a number"
	cdr_value=$(uint_normalize "$cdr_value")

	if [ "$cdr_selector" = last ]; then
		formatter_run cdr --limit "$cdr_value"
	else
		formatter_run cdr --seq "$cdr_value"
	fi
}

voice_show() {
	[ $# -ge 1 ] || fail 'show: not enough arguments; show <config|version|global|channelN|daemon|lines|calls|monitor|cdr|status|statistics|log|raw>'

	show_what=$1
	shift

	case $show_what in
	config)
		uci show voip
		;;
	version)
		version_show
		;;
	global)
		if [ -n "$1" ]; then
			uci show "voip.base.$1"
		else
			formatter_run config
		fi
		;;
	channel*)
		channel_show "$show_what" "$1"
		;;
	daemon)
		formatter_run status
		;;
	lines | calls | monitor)
		formatter_run "$show_what"
		;;
	cdr)
		cdr_show "$1" "$2"
		;;
	status)
		show_status=$(voice_status_get) || return 1
		line_range_run line_status_show "$show_status" "$1" "$2"
		;;
	statistics)
		stats_show "$1" "$2" "$3"
		;;
	log)
		log_show "$@"
		;;
	raw)
		raw_show
		;;
	tlskey)
		if [ -f "$tls_keylog" ]; then
			cat "$tls_keylog"
		else
			echo 'TLS key log not found'
		fi
		;;
	tls-status)
		# The helper writes the status with no final newline.
		if [ -f "$tls_status" ]; then
			printf '%s\n' "$(cat "$tls_status")"
		else
			echo 'TLS certificate status not found'
		fi
		;;
	reg | ram)
		unsupported "show $show_what"
		;;
	*)
		fail "show: invalid argument \"$show_what\""
		;;
	esac
}

uci_staged=''

uci_stage() {
	uci_staged=1
	uci set "$1=$2" || fail "uci set $1 failed"
}

region_set() {
	# A provisioning script can emit commas, while operator lists can use
	# whitespace. When the list has no entries, the daemon validates the
	# value: its region row is free-form.
	case $1 in
	'' | *[!A-Za-z0-9_-]*)
		fail "invalid region \"$1\""
		;;
	esac

	region_supported=$(uci -q get voip.base.supported_regions)
	region_supported=$(printf '%s' "$region_supported" | tr ',\t' '  ')
	case $region_supported in
	*[![:space:]]*) ;;
	*)
		uci_stage voip.base.region "$1"
		return
		;;
	esac

	case " $region_supported " in
	*" $1 "*)
		uci_stage voip.base.region "$1"
		;;
	*)
		fail "invalid region \"$1\"; valid regions: $region_supported"
		;;
	esac
}

global_set() {
	[ $# -ge 1 ] || fail 'set global: not enough arguments; set global <param> <value>'

	case $1 in
	log_module | log_preset)
		unsupported "set global $1"
		;;
	tls_cert_path | tls_cert_username | tls_cert_password)
		# The klish commands document 'none' as the value that clears.
		if [ "$2" = none ]; then
			uci_stage "voip.base.$1" ''
		else
			uci_stage "voip.base.$1" "$2"
		fi
		;;
	region)
		region_set "$2"
		;;
	*)
		uci_stage "voip.base.$1" "$2"
		;;
	esac
}

line_set() {
	[ $# -ge 3 ] || fail 'set line: not enough arguments; set line <line> <param> <value>'

	# A plain number is a line index and gets range checked. The klish
	# codecs command sends "1_g711u", the per codec sub section of a line,
	# and that reference carries no index of its own.
	if uint_check "$1"; then
		line_count=$(uci_channels_get)
		if [ "$line_count" -gt 0 ] && [ "$1" -gt "$line_count" ]; then
			fail "set line: invalid line $1"
		fi
	fi

	uci_stage "voip.channel$1.$2" "$3"
}

profile_set() {
	[ $# -ge 3 ] || fail 'set profile: not enough arguments; set profile <name> <param> <value>'

	uci_stage "voip.profile_$1" profile
	uci_stage "voip.profile_$1.id" "$1"
	uci_stage "voip.profile_$1.$2" "$3"
}

config_apply() {
	uci commit voip || fail 'uci commit voip failed'

	# The write already landed, so a daemon that cannot be reached is a
	# warning and not a failure: it reads the file at its next start.
	ubus -t "$ubus_timeout" call voice reload >/dev/null 2>&1 ||
		printf '%s: voice reload failed, the daemon reads the change at its next start\n' \
			"$prog" >&2
}

voice_set() {
	[ $# -ge 1 ] || fail 'set: not enough arguments; set <global|line|profile> ...'

	set_target=$1
	shift

	case $set_target in
	global) global_set "$@" ;;
	line) line_set "$@" ;;
	profile) profile_set "$@" ;;
	*) fail "set: invalid argument \"$set_target\"; expected <global|line|profile>" ;;
	esac

	config_apply
}

profile_apply() {
	apply_section=$1
	apply_target=$2

	apply_dump=$(uci -q show "voip.$apply_section")
	[ -n "$apply_dump" ] || fail "apply: no profile \"$apply_section\""

	# Only the option names come out of the dump. uci show quotes and
	# escapes the value it prints, so a value carrying a quote would arrive
	# corrupted; each one is read back raw instead. The loop takes its input
	# from a here document and not a pipe, so a refusal inside it still ends
	# the script and still reverts what it staged.
	while IFS= read -r apply_line; do
		apply_key=${apply_line%%=*}
		apply_option=${apply_key#"voip.$apply_section."}

		# The section line itself carries no option name
		[ "$apply_option" != "$apply_key" ] || continue
		[ "$apply_option" != id ] || continue

		apply_value=$(uci -q get "voip.$apply_section.$apply_option")
		uci_stage "voip.$apply_target.$apply_option" "$apply_value"
	done <<EOF
$apply_dump
EOF
}

voice_apply() {
	[ $# -ge 3 ] || fail 'apply: not enough arguments; apply profile <profile-name> <line-ref>'
	[ "$1" = profile ] || fail "apply: invalid argument \"$1\"; expected \"profile\""

	# The klish apply ACTION builds "channel${v_line}" or "channel${which}".
	# Naming the target section shape here keeps a profile from being copied
	# over the base section or over another profile.
	apply_ref_number=${3#channel}
	if [ "$apply_ref_number" = "$3" ] || ! uint_check "$apply_ref_number"; then
		fail "apply: invalid line reference \"$3\"; expected channel<N>"
	fi

	profile_apply "profile_$2" "$3"
	config_apply
}

#
# Entry
#

[ $# -ge 1 ] || {
	usage_show >&2
	exit 1
}

action=$1
shift

case $action in
start | stop | restart)
	voice_service "$action"
	;;
seize | release)
	voice_cmd "$action" "$1" ''
	;;
dial)
	voice_cmd dial "$1" "$2"
	;;
stats_live)
	stats_live_show "$1" "$2"
	;;
line_test)
	line_test_show "$1" "$2"
	;;
looptest)
	looptest_show "$1"
	;;
calltrace)
	calltrace_run "$@"
	;;
show)
	voice_show "$@"
	;;
set)
	voice_set "$@"
	;;
apply)
	voice_apply "$@"
	;;
*)
	printf '%s: unknown cmd "%s"\n' "$prog" "$action" >&2
	usage_show >&2
	exit 1
	;;
esac

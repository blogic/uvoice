<!--
  The DUT is the transferor of an attended transfer that fails, and resumes
  the held call instead of ending it.

  The DUT places the call, holds it and sends the REFER (RFC 3515 section
  2.4.6). The subscriber dials `*073` and a
  target (flow `xfer-failed`). The hold re-INVITE must carry `a=sendonly` or
  `a=inactive`, and this peer answers `recvonly`. The REFER must name a target
  in its Refer-To, and carry no Replaces. This peer captures the From tag of
  the DUT from the INVITE, and the CSeq of the REFER.

  This peer accepts the referral with 202, and reports a 486 in the
  `message/sipfrag` body of its one NOTIFY: `SIP/2.0 486 Busy Here`, under
  `Subscription-State: terminated;reason=noresource`.

  The call survives, and that is the assertion. A failed transfer resumes the
  leg that it was going to give away. The next message must therefore be a
  re-INVITE that takes the hold off. The resume must carry none of
  `a=sendonly`, `a=inactive` or `a=recvonly`: with no one-way value, the
  direction is `sendrecv` (RFC 4566 section 6).

  This peer answers the resume with `a=sendrecv`. A DUT that sent a BYE
  instead would abort the call here on an unexpected message. The BYE of the
  ordinary hook then ends the call.

  A SIPp regexp lives in an XML attribute, and an attribute cannot hold the
  `<` of a name-addr. `test/e2e/run_e2e.sh` therefore checks the exact
  Refer-To and Referred-By values off the message log, as the stream flows
  check the Via token. This file checks the message order, the target inside
  the Refer-To header, and the absence of a Replaces on an attended referral.

  The scenario carries no `rtp_echo`, the rule for stream scenarios in
  `test/e2e/README.md`, section "The two SIPp builds".

  RFC 3515 section 2.4.6, RFC 3420.
-->
<scenario name="UAS attended transfer refused, the DUT resumes the held call">
  <!-- The DUT can register against this peer before its call, and a UAS run
       has one scenario for every request that reaches it. The first receive
       therefore takes the REGISTER too, and its branch answers 200 and ends.
       The action list of that receive runs for the REGISTER as well, so it
       stores the values of the INVITE, and a later receive checks them
       (test/sipp/README.md, "The REGISTER branch"). -->
  <recv request="REGISTER|INVITE" regexp_match="true" timeout="60000" rrs="true"
        next="call" test="invite_seen">
    <action>
      <ereg regexp="^INVITE[[:space:]]" search_in="msg" assign_to="invite_seen"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:"
            assign_to="register_via,register_transport,register_sent_by,register_branch"/>
      <!-- the remote tag this peer needs to address the NOTIFY into the dialog -->
      <ereg regexp=";tag=([^;[:space:]]+)" search_in="hdr" header="From:"
            assign_to="junk,dut_tag"/>
    </action>
  </recv>

  <send next="registered_done">
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$register_transport] [$register_sent_by];branch=[$register_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      [last_Expires:]
      Content-Length: 0

    ]]>
  </send>

  <label id="call"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp call
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000">
    <action>
      <ereg regexp="." search_in="var" variable="junk"
            check_it="true" assign_to="initial_check"/>
    </action>
  </recv>

  <!-- The hook flash holds the call first. The transfer code is dialled from
       HOLD_DIAL, so the leg the REFER rides is a held leg and the hold
       re-INVITE comes in front of the referral. -->
  <recv request="INVITE" timeout="20000">
    <action>
      <ereg regexp="a=sendonly|a=inactive" search_in="body" check_it="true"
            assign_to="hold_dir"/>
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 2 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp call
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=recvonly
    ]]>
  </send>

  <recv request="ACK" timeout="10000"/>

  <!-- The REFER. Refer-To names the target the subscriber collected, and an
       attended referral carries no Replaces at all: the target is a bare
       number and not a dialog this side already holds. -->
  <recv request="REFER" timeout="30000">
    <action>
      <ereg regexp="sip:[0-9]+@127\.0\.0\.1" search_in="hdr" header="Refer-To:"
            check_it="true" assign_to="refer_to"/>
      <ereg regexp="Replaces" search_in="msg" check_it_inverse="true"
            assign_to="no_replaces"/>
      <ereg regexp="([0-9]+)[[:space:]]+REFER" search_in="hdr" header="CSeq:"
            check_it="true" assign_to="junk,refer_cseq"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 202 Accepted
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <!-- The implicit subscription's one notification: the referral failed and
       the subscription ends with it (RFC 3515 2.4.6, RFC 3420). The id is the
       CSeq of the REFER this NOTIFY belongs to. -->
  <send retrans="500" start_txn="notify">
    <![CDATA[
      NOTIFY [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <sip:sipp@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: <sip:5551000@127.0.0.1>;tag=[$dut_tag]
      [last_Call-ID:]
      CSeq: 1 NOTIFY
      Max-Forwards: 70
      [routes]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Event: refer;id=[$refer_cseq]
      Subscription-State: terminated;reason=noresource
      Content-Type: message/sipfrag;version=2.0
      Content-Length: [len]

      SIP/2.0 486 Busy Here
    ]]>
  </send>

  <recv response="200" response_txn="notify" timeout="10000"/>

  <!-- The resume is the verdict. A transferor that read the sipfrag 486 keeps
       the call and takes the hold off it, so the re-INVITE comes before any
       BYE and it offers the two-way session again.

       The offer is read for what it does not carry. A stream with no direction
       attribute is sendrecv (RFC 4566 6), and the DUT writes the attribute
       only while it holds, so the pin is the absence of every one-way value. -->
  <recv request="INVITE" timeout="30000">
    <action>
      <ereg regexp="a=sendonly|a=inactive|a=recvonly" search_in="body"
            check_it_inverse="true" assign_to="resume_dir"/>
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 3 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp call
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000"/>

  <!-- and the call ends the ordinary way, on the subscriber's own hook -->
  <recv request="BYE" timeout="30000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <label id="registered_done"/>
  <Reference variables="register_via,initial_check,junk,hold_dir,refer_to,no_replaces,resume_dir"/>
</scenario>

<!--
  The DUT refuses a T.38 image stream with port 0, and keeps the active audio
  stream.

  The DUT calls out, and this peer answers with PCMU alone. It then sends a
  re-INVITE that offers a live `m=audio` RTP/AVP line and an `m=image` udptl
  t38 line. The 200 must keep the audio at a nonzero port, and return the
  image at port 0. The scenario covers the disabled path, so the DUT must run
  with `fax_t38_enable` 0. This peer ends the call with a BYE that uses the
  URIs and the tag of the first INVITE.

  RFC 3264 section 8.2.
-->
<scenario name="UAS T.38 re-INVITE rejection">
  <!-- The DUT can register against this peer before its call, and a UAS run
       has one scenario for every request that reaches it. The first receive
       therefore takes the REGISTER too, and its branch answers 200 and ends.
       The action list of that receive runs for the REGISTER as well, so it
       stores the values of the INVITE, and a later receive checks them
       (test/sipp/README.md, "The REGISTER branch"). -->
  <recv request="REGISTER|INVITE" regexp_match="true" timeout="60000" rrs="true"
        next="call" test="invite_seen">
    <action>
      <ereg regexp="^INVITE[[:space:]]" search_in="msg" assign_to="invite_seen"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:"
            assign_to="register_via,register_transport,register_sent_by,register_branch"/>
      <ereg regexp="From:[^&lt;]*&lt;([^&gt;]+)&gt;.*;tag=([^;[:space:]]+)"
            search_in="msg"
            assign_to="from_match,remote_uri,remote_tag"/>
      <ereg regexp="To:[^&lt;]*&lt;([^&gt;]+)&gt;"
            search_in="msg"
            assign_to="to_match,local_uri"/>
    </action>
  </recv>

  <send next="registered_done">
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$register_transport] [$register_sent_by];branch=[$register_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      [last_Expires:]
      Content-Length: 0

    ]]>
  </send>

  <label id="call"/>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp T38
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000">
    <action>
      <ereg regexp="." search_in="var" variable="from_match"
            check_it="true" assign_to="initial_check"/>
      <ereg regexp="." search_in="var" variable="to_match"
            check_it="true" assign_to="initial_check"/>
    </action>
  </recv>

  <send retrans="500" start_txn="t38">
    <![CDATA[
      INVITE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <[$local_uri]>;tag=sipp-[pid]-[call_number]
      To: <[$remote_uri]>;tag=[$remote_tag]
      [last_Call-ID:]
      CSeq: 1 INVITE
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      [routes]
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 2 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp T38
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
      a=sendrecv
      m=image [media_port+2] udptl t38
      a=T38FaxVersion:0
      a=T38FaxMaxDatagram:400
    ]]>
  </send>

  <recv response="200" response_txn="t38" timeout="10000" rrs="true">
    <action>
      <ereg regexp="m=audio[[:space:]]+[1-9][0-9]*[[:space:]]+RTP/AVP"
            search_in="body" check_it="true" assign_to="audio_preserved"/>
      <ereg regexp="m=image[[:space:]]+0[[:space:]]+udptl"
            search_in="body" check_it="true" assign_to="image_rejected"/>
    </action>
  </recv>

  <send ack_txn="t38">
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <[$local_uri]>;tag=sipp-[pid]-[call_number]
      To: <[$remote_uri]>;tag=[$remote_tag]
      [last_Call-ID:]
      CSeq: 1 ACK
      Max-Forwards: 70
      [routes]
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <[$local_uri]>;tag=sipp-[pid]-[call_number]
      To: <[$remote_uri]>;tag=[$remote_tag]
      [last_Call-ID:]
      CSeq: 2 BYE
      Max-Forwards: 70
      [routes]
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" timeout="10000"/>
  <label id="registered_done"/>
  <Reference variables="register_via,initial_check,audio_preserved,image_rejected"/>
</scenario>

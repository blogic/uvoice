<!--
  The DUT answers an RFC 2069 digest challenge in the provider style: no qop,
  cnonce or nc, and the opaque echoed.

  The first REGISTER must carry `rport` in its Via. This peer answers it 401
  with `WWW-Authenticate: Digest realm="sip.example.com"`, a nonce, the opaque
  `uvoice-opaque-2069` and no qop.

  The Authorization of the retry must start with `Digest` and echo that
  opaque. An inverse check requires that it carries no qop, cnonce or nc
  field. This peer then grants a 60-second binding.

  RFC 2069 section 2.1.2, RFC 3261 section 22.4.
-->
<scenario name="UAS REGISTER with RFC 2069 digest">
  <recv request="REGISTER" timeout="60000">
    <action>
      <ereg regexp="(^|;)[[:space:]]*rport([;[:space:]]|$)"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="via_rport"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="via_match,via_transport,via_sent_by,via_branch"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 401 Unauthorized
      Via: SIP/2.0/[$via_transport] [$via_sent_by];branch=[$via_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="sip.example.com", nonce="uvoice-rfc2069-nonce", opaque="uvoice-opaque-2069"
      Content-Length: 0

    ]]>
  </send>

  <recv request="REGISTER" timeout="30000">
    <action>
      <ereg regexp="Digest[[:space:]]"
            search_in="hdr" header="Authorization:"
            check_it="true" assign_to="authorization_digest"/>
      <ereg regexp="opaque[[:space:]]*=[[:space:]]*&quot;uvoice-opaque-2069&quot;"
            search_in="hdr" header="Authorization:" check_it="true"
            assign_to="authorization_opaque"/>
      <ereg regexp="(^|[,[:space:]])(qop|cnonce|nc)[[:space:]]*="
            search_in="hdr" header="Authorization:" check_it_inverse="true"
            assign_to="authorization_qop_fields"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="via_match,via_transport,via_sent_by,via_branch"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$via_transport] [$via_sent_by];branch=[$via_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      Expires: 60
      Content-Length: 0

    ]]>
  </send>

  <Reference variables="via_rport,via_match,authorization_digest,authorization_opaque,authorization_qop_fields"/>
</scenario>

<!--
  The DUT is the transferee of a consult referral, and must promote the
  escaped Replaces of the Refer-To into one Replaces header.

  It is the `uac_xfer_refer.xml` exchange with a Replaces inside the Refer-To
  URI. This peer calls the DUT and, when the call is up, refers it to a target
  of its own. The child INVITE comes back here, and the out-of-call peer
  `xfer_peer_ooc.xml` answers it (`SIPP_OOC_SCENARIO`). The Refer-To is
  `<sip:xfer@local?Replaces=xfercall99%40127.0.0.1%3Bto-tag%3Dpeertag99%3Bfrom-tag%3Dduttag99>`.

  The embedded Replaces must be escaped. Every separator inside a URI header
  value ends the URI where it stands (RFC 3261 section 25.1). The '@', the ';'
  and the '=' of the dialog identity therefore travel as %40, %3B and %3D. The
  DUT unescapes the value and promotes it into exactly one Replaces header of
  the child INVITE, beside `Require: replaces` (RFC 3891 section 4). The
  identity names no dialog that anybody holds: the promotion is under test,
  and the far end answers the child either way.

  This file checks the two notifications of the implicit subscription and
  their order. The first is "SIP/2.0 100 Trying" under an active subscription.
  The second is the child's final, 200, under a terminated one. A DUT that
  skips either one, or sends them in the other order, fails here.

  The harness checks the promoted header of the child INVITE from the message
  log (`test/e2e/run_e2e.sh`, `xfer_hdr_check`). The scenario carries no
  `rtp_echo`, by the stream-scenario rule of `test/e2e/README.md`.

  RFC 3515 section 2.4.2, RFC 3891.
-->
<scenario name="UAC consult referral, the DUT promotes the embedded Replaces">
  <send retrans="500" start_txn="invite">
    <![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      From: SIPp <sip:sipp@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: DUT <sip:[service]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      Supported: timer
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp call
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=sendrecv
    ]]>
  </send>

  <recv response="100" response_txn="invite" optional="true"/>
  <recv response="180" response_txn="invite" timeout="15000"/>
  <recv response="200" response_txn="invite" timeout="30000" rrs="true"/>

  <send ack_txn="invite">
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: SIPp <sip:sipp@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: DUT <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      [routes]
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="500"/>

  <!-- The referral. Refer-To names a target of this peer's own and carries the
       escaped Replaces a consult transfer produces, so the child INVITE the
       DUT places lands back here with the promoted header on it. -->
  <send retrans="500" start_txn="refer">
    <![CDATA[
      REFER [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: SIPp <sip:sipp@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: DUT <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 REFER
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      [routes]
      Refer-To: <sip:xfer@[local_ip]:[local_port]?Replaces=xfercall99%40127.0.0.1%3Bto-tag%3Dpeertag99%3Bfrom-tag%3Dduttag99>
      Referred-By: <sip:sipp@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <recv response="202" response_txn="refer" timeout="10000"/>

  <!-- The first notification: the referral was taken and the child is being
       placed, under a subscription that is still active (RFC 3515 2.4.4). -->
  <recv request="NOTIFY" timeout="15000">
    <action>
      <ereg regexp="^SIP/2\.0 100 " search_in="body" check_it="true"
            assign_to="notify_trying"/>
      <ereg regexp="^[ \t]*active(;|$)" search_in="hdr" header="Subscription-State:"
            check_it="true" assign_to="sub_active"/>
      <ereg regexp="^[ \t]*refer(;|$)" search_in="hdr" header="Event:"
            check_it="true" assign_to="notify_event"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- the child INVITE reaches the out-of-call peer between these two, and the
       second notification carries the answer it earned -->
  <recv request="NOTIFY" timeout="30000">
    <action>
      <ereg regexp="^SIP/2\.0 200 " search_in="body" check_it="true"
            assign_to="notify_final"/>
      <ereg regexp="^[ \t]*terminated;reason=noresource$" search_in="hdr" header="Subscription-State:"
            check_it="true" assign_to="sub_done"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- The pause holds the swapped pair still. Between the child's answer and
       this BYE both legs are on the line under swapped names, and that state
       is what the harness reads; without the pause it lasts microseconds
       (test/e2e/run_e2e.sh, the swapped assertion). -->
  <pause milliseconds="1500"/>

  <!-- The transferor ends the transferred call once the referral completed,
       which is what a transferee's five second guard exists to cover when it
       does not (call.h CALL_XFER_BYE_MS). -->
  <send retrans="500" start_txn="bye">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: SIPp <sip:sipp@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: DUT <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 3 BYE
      Max-Forwards: 70
      [routes]
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" response_txn="bye" timeout="10000"/>

  <!-- The run outlives this call on purpose. The referred call is still up on
       the out-of-call scenario, and the subscriber's hook is what ends it;
       SIPp aborts every call that is still alive when its last scenario
       finishes, and an aborted call leaves a record that never closes. -->
  <pause milliseconds="4000"/>

  <Reference variables="notify_trying,sub_active,notify_event,notify_final,sub_done"/>
</scenario>

<!--
  A 422 with `Min-SE: 900` makes the DUT retry the INVITE with a
  Session-Expires of at least 900.

  The first INVITE must carry a Session-Expires header. This peer answers it
  with 422 Session Interval Too Small and `Min-SE: 900`. The Session-Expires
  of the retry must read 900 or more: the check accepts 900 to 999, or four
  digits and more. This peer answers the retry with `Require: timer` and
  `Session-Expires: 900;refresher=uac`.

  RFC 4028 sections 7.4 and 9.
-->
<scenario name="UAS session timer 422">
  <!-- The DUT can register against this peer before its call, and a UAS run
       has one scenario for every request that reaches it. The first receive
       therefore takes the REGISTER too, and its branch answers 200 and ends.
       The action list of that receive runs for the REGISTER as well, so it
       stores the values of the INVITE, and a later receive checks them
       (test/sipp/README.md, "The REGISTER branch"). -->
  <recv request="REGISTER|INVITE" regexp_match="true" timeout="60000"
        next="call" test="invite_seen">
    <action>
      <ereg regexp="^INVITE[[:space:]]" search_in="msg" assign_to="invite_seen"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:"
            assign_to="register_via,register_transport,register_sent_by,register_branch"/>
      <ereg regexp="Session-Expires:[[:space:]]*[0-9]+"
            search_in="msg" assign_to="initial_session_expires"/>
    </action>
  </recv>

  <send next="registered_done">
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$register_transport] [$register_sent_by];branch=[$register_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      [last_Expires:]
      Content-Length: 0

    ]]>
  </send>

  <label id="call"/>

  <send>
    <![CDATA[
      SIP/2.0 422 Session Interval Too Small
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Min-SE: 900
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK" timeout="10000">
    <action>
      <ereg regexp="." search_in="var" variable="initial_session_expires"
            check_it="true" assign_to="initial_check"/>
    </action>
  </recv>
  <recv request="INVITE" timeout="15000">
    <action>
      <ereg regexp="Session-Expires:[[:space:]]*(9[0-9]{2}|[1-9][0-9]{3,})([;[:space:]]|$)"
            search_in="msg" check_it="true" assign_to="retry_session_expires"/>
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Require: timer
      Session-Expires: 900;refresher=uac
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp session timer
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000"/>
  <recv request="BYE" timeout="60000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <label id="registered_done"/>
  <Reference variables="register_via,initial_check,retry_session_expires"/>
</scenario>

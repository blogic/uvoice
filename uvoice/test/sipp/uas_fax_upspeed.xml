<!--
  The DUT places a G.711 fax upspeed when its detector reports the fax answer
  tone.

  The DUT calls out, and this scenario answers with G.729 alone, so the
  committed codec is one that no fax carrier survives. The first INVITE must
  offer G.729 (`a=rtpmap:18 G729/8000`). The runner then injects a CED toward
  the phone over ubus.

  The DUT must re-INVITE with an offer of G.711 alone. The media line must
  read `m=audio <port> RTP/AVP 0 8 101`, ended by a control character. The
  G.729 payload type and its rtpmap must be gone, and the offer must carry no
  comfort noise (`a=rtpmap:13 CN`).

  This peer answers with PCMU, and ends the call with a BYE that uses the URIs
  and the tag of the first INVITE. The scenario runs with either value of
  `fax_t38_enable`.

  RFC 3261 section 14, RFC 3264 section 8, ITU-T T.30 answer tone.
-->
<scenario name="UAS answered call with a DUT G.711 fax upspeed">
  <!-- The DUT can register against this peer before its call, and a UAS run
       has one scenario for every request that reaches it. The first receive
       therefore takes the REGISTER too, and its branch answers 200 and ends.
       The action list of that receive runs for the REGISTER as well, so it
       stores the values of the INVITE, and a later receive checks them
       (test/sipp/README.md, "The REGISTER branch"). -->
  <recv request="REGISTER|INVITE" regexp_match="true" timeout="60000" rrs="true"
        next="call" test="invite_seen">
    <action>
      <ereg regexp="^INVITE[[:space:]]" search_in="msg" assign_to="invite_seen"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:"
            assign_to="register_via,register_transport,register_sent_by,register_branch"/>
      <ereg regexp="From:[^&lt;]*&lt;([^&gt;]+)&gt;.*;tag=([^;[:space:]]+)"
            search_in="msg"
            assign_to="from_match,remote_uri,remote_tag"/>
      <ereg regexp="To:[^&lt;]*&lt;([^&gt;]+)&gt;"
            search_in="msg"
            assign_to="to_match,local_uri"/>
      <!-- the voice call offers the configured priority order, G.729 first -->
      <ereg regexp="a=rtpmap:18 G729/8000" search_in="body"
            assign_to="voice_offer"/>
    </action>
  </recv>

  <send next="registered_done">
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$register_transport] [$register_sent_by];branch=[$register_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      [last_Expires:]
      Content-Length: 0

    ]]>
  </send>

  <label id="call"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp fax
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 18 101
      a=rtpmap:18 G729/8000
      a=rtpmap:101 telephone-event/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000">
    <action>
      <ereg regexp="." search_in="var" variable="from_match"
            check_it="true" assign_to="initial_check"/>
      <ereg regexp="." search_in="var" variable="to_match"
            check_it="true" assign_to="initial_check"/>
      <ereg regexp="." search_in="var" variable="voice_offer"
            check_it="true" assign_to="initial_check"/>
    </action>
  </recv>

  <!-- The runner injects the answer tone over ubus, which puts the upspeed
       re-INVITE on the wire. Its offer must carry G.711 alone: the two G.711
       payload types and the telephone-event the channel still negotiates, with
       no trace of the G.729 the call was committed to. -->
  <recv request="INVITE" timeout="30000">
    <action>
      <!-- the control character is the CR that ends the m= line, so the
           format list is exactly these three entries and nothing more -->
      <ereg regexp="m=audio[[:space:]]+[0-9]+[[:space:]]+RTP/AVP 0 8 101[[:cntrl:]]"
            search_in="body" check_it="true" assign_to="fax_offer"/>
      <ereg regexp="a=rtpmap:18" search_in="body" check_it_inverse="true"
            assign_to="fax_no_g729"/>
      <ereg regexp="a=rtpmap:13 CN" search_in="body" check_it_inverse="true"
            assign_to="fax_no_cn"/>
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 2 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp fax
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000"/>

  <!-- Hold the converted call long enough for the runner to read the stub
       dump back; without this the BYE leaves microseconds after the ACK. -->
  <pause milliseconds="2000"/>

  <send retrans="500" start_txn="bye">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <[$local_uri]>;tag=sipp-[pid]-[call_number]
      To: <[$remote_uri]>;tag=[$remote_tag]
      [last_Call-ID:]
      CSeq: 3 BYE
      Max-Forwards: 70
      [routes]
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" response_txn="bye" timeout="10000"/>
  <label id="registered_done"/>
  <Reference variables="register_via,initial_check,fax_offer,fax_no_g729,fax_no_cn"/>
</scenario>

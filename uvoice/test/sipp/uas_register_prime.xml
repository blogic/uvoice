<!--
  The DUT registers without authentication before a caller starts, and the
  binding lasts `Expires: [expires]` seconds. The harness sets the keyword
  with `-key expires <seconds>`, so the caller acts inside the binding.

  The REGISTER must carry `rport` in its Via. The 200 carries the Via back
  with `received` and `rport` parameters, as `uas_register` does.

  RFC 3261 sections 10.2.1 and 10.3.
-->
<scenario name="UAS REGISTER before a call">
  <recv request="REGISTER" timeout="60000">
    <action>
      <ereg regexp="(^|;)[[:space:]]*rport([;[:space:]]|$)"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="via_rport"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="via_match,via_transport,via_sent_by,via_branch"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$via_transport] [$via_sent_by];branch=[$via_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      Expires: [expires]
      Content-Length: 0

    ]]>
  </send>

  <Reference variables="via_rport,via_match"/>
</scenario>

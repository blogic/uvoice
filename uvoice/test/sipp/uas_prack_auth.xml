<!--
  A challenged INVITE keeps its RFC 3262 advertisement. The RAck of the PRACK
  names the CSeq of the answered INVITE: the retry, not the challenged one.

  This peer answers the first INVITE 401 with a Digest challenge (nonce
  `uvoice-prack-nonce`). The retried INVITE must carry that nonce in
  Authorization, and `100rel` in Supported. The reliable 180 behind it (`RSeq:
  4242`) draws a PRACK. A `strcmp` action compares the CSeq number in its RAck
  with the one captured from the retry.

  RFC 3262 sections 4 and 7.2, RFC 3261 section 22.2.
-->
<scenario name="UAS challenged INVITE answered reliably">
  <!-- The DUT can register against this peer before its call, and a UAS run
       has one scenario for every request that reaches it. The first receive
       therefore takes the REGISTER too, and its branch answers 200 and ends.
       The action list of that receive runs for the REGISTER as well, so it
       stores the values of the INVITE, and a later receive checks them
       (test/sipp/README.md, "The REGISTER branch"). -->
  <recv request="REGISTER|INVITE" regexp_match="true" timeout="60000"
        next="call" test="invite_seen">
    <action>
      <ereg regexp="^INVITE[[:space:]]" search_in="msg" assign_to="invite_seen"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:"
            assign_to="register_via,register_transport,register_sent_by,register_branch"/>
      <ereg regexp="(^|[,[:space:]])100rel([,[:space:]]|$)"
            search_in="hdr" header="Supported:"
            assign_to="first_supported"/>
      <ereg regexp="^[[:space:]]*([0-9]+)[[:space:]]+INVITE[[:space:]]*$"
            search_in="hdr" header="CSeq:"
            assign_to="first_cseq_line,first_cseq"/>
    </action>
  </recv>

  <send next="registered_done">
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$register_transport] [$register_sent_by];branch=[$register_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      [last_Expires:]
      Content-Length: 0

    ]]>
  </send>

  <label id="call"/>

  <send>
    <![CDATA[
      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="uvoice.example", nonce="uvoice-prack-nonce", opaque="uvoice-opaque-prack", algorithm=MD5
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK" timeout="10000">
    <action>
      <ereg regexp="." search_in="var" variable="first_supported"
            check_it="true" assign_to="initial_check"/>
      <ereg regexp="." search_in="var" variable="first_cseq_line"
            check_it="true" assign_to="initial_check"/>
    </action>
  </recv>

  <recv request="INVITE" timeout="30000" rrs="true">
    <action>
      <ereg regexp="nonce[[:space:]]*=[[:space:]]*&quot;uvoice-prack-nonce&quot;"
            search_in="hdr" header="Authorization:" check_it="true"
            assign_to="retry_authorization"/>
      <ereg regexp="(^|[,[:space:]])100rel([,[:space:]]|$)"
            search_in="hdr" header="Supported:" check_it="true"
            assign_to="retry_supported"/>
      <ereg regexp="^[[:space:]]*(.*)$"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="retry_via_line,retry_via"/>
      <ereg regexp="^[[:space:]]*([0-9]+)[[:space:]]+INVITE[[:space:]]*$"
            search_in="hdr" header="CSeq:" check_it="true"
            assign_to="retry_cseq_line,retry_cseq"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Require: 100rel
      RSeq: 4242
      Content-Length: 0

    ]]>
  </send>

  <recv request="PRACK" timeout="10000">
    <action>
      <ereg regexp="^[[:space:]]*4242[[:space:]]+([0-9]+)[[:space:]]+INVITE[[:space:]]*$"
            search_in="hdr" header="RAck:" check_it="true"
            assign_to="rack_line,rack_cseq"/>
      <strcmp variable="rack_cseq" variable2="retry_cseq" check_it="true"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      Via: [$retry_via]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      CSeq: [$retry_cseq] INVITE
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP[media_ip_type] [media_ip]
      s=uvoice SIPp prack
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000"/>

  <pause milliseconds="2000"/>

  <recv request="BYE" timeout="60000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <label id="registered_done"/>
  <Reference variables="register_via,initial_check,first_supported,first_cseq_line,first_cseq,retry_authorization,retry_supported,retry_via_line,retry_cseq_line,rack_line"/>
</scenario>

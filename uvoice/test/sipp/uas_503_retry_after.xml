<!--
  Retry-After 5 on a 503 delays the next REGISTER of the DUT by at least five
  seconds.

  This peer answers the first REGISTER with 503 Service Unavailable and
  `Retry-After: 5`, and grants the retry a 60-second binding.

  `run_sipp.sh` checks the delay from the packet timestamps.
  `timing_503_check()` reads the 503 and the next REGISTER with tshark, and
  requires at least 5.0 seconds between them. The scenario therefore needs
  tcpdump and tshark, and fails without them.

  RFC 3261 section 21.5.4.
-->
<scenario name="UAS REGISTER 503 Retry-After">
  <recv request="REGISTER" timeout="60000"/>

  <send>
    <![CDATA[
      SIP/2.0 503 Service Unavailable
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Retry-After: 5
      Content-Length: 0

    ]]>
  </send>

  <recv request="REGISTER" timeout="15000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      Expires: 60
      Content-Length: 0

    ]]>
  </send>
</scenario>

<!--
  The DUT answers a `qop=auth` digest challenge with a cnonce, a nonce count
  of eight hex digits and the opaque echoed.

  This peer answers the first REGISTER 401 with `WWW-Authenticate: Digest
  realm="uvoice.example"`, `algorithm=MD5`, `qop="auth"`, a nonce and the
  opaque `uvoice-opaque-qop`. The Authorization of the retry must carry
  `qop=auth`, a quoted cnonce, an nc of eight hex digits and that opaque. This
  peer then grants a 60-second binding.

  RFC 3261 section 22.4, RFC 2617 section 3.2.2.
-->
<scenario name="UAS REGISTER with qop auth digest">
  <recv request="REGISTER" timeout="60000">
    <action>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="via_match,via_transport,via_sent_by,via_branch"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 401 Unauthorized
      Via: SIP/2.0/[$via_transport] [$via_sent_by];branch=[$via_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="uvoice.example", nonce="uvoice-qop-auth-nonce", opaque="uvoice-opaque-qop", algorithm=MD5, qop="auth"
      Content-Length: 0

    ]]>
  </send>

  <recv request="REGISTER" timeout="30000">
    <action>
      <ereg regexp="qop[[:space:]]*=[[:space:]]*auth([,[:space:]]|$)"
            search_in="hdr" header="Authorization:" check_it="true"
            assign_to="authorization_qop"/>
      <ereg regexp="cnonce[[:space:]]*=[[:space:]]*&quot;[^&quot;]+&quot;"
            search_in="hdr" header="Authorization:" check_it="true"
            assign_to="authorization_cnonce"/>
      <ereg regexp="nc[[:space:]]*=[[:space:]]*[0-9A-Fa-f]{8}([,[:space:]]|$)"
            search_in="hdr" header="Authorization:" check_it="true"
            assign_to="authorization_nc"/>
      <ereg regexp="opaque[[:space:]]*=[[:space:]]*&quot;uvoice-opaque-qop&quot;"
            search_in="hdr" header="Authorization:" check_it="true"
            assign_to="authorization_opaque"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:" check_it="true"
            assign_to="via_match,via_transport,via_sent_by,via_branch"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$via_transport] [$via_sent_by];branch=[$via_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      Expires: 60
      Content-Length: 0

    ]]>
  </send>

  <Reference variables="via_match,authorization_qop,authorization_cnonce,authorization_nc,authorization_opaque"/>
</scenario>

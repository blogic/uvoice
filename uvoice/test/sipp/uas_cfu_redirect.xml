<!--
  Local call forwarding on the unconditional condition: the DUT answers an
  offered call with a 302 to the configured target, and never rings.

  The switch registers the DUT with a 3600-second binding. The config of the
  DUT sets the condition with a target. This peer then offers a call to
  5551000.

  The DUT must answer 302, with the target `<sip:5552000@127.0.0.1>` in its
  Contact. It must never ring: a 180 before the 302 is an unexpected message,
  and it aborts the call. The ACK of this peer reuses the branch of the
  INVITE, as the ACK of a non-2xx answer must. Only the end-to-end harness
  runs this scenario (`cfu_redirect_run()`).

  RFC 3261 sections 8.2.6, 17.1.1.3 and 21.3.3.
-->
<scenario name="UAS unconditional call forward redirect">
  <recv request="REGISTER" timeout="60000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-register
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      Expires: 3600
      Content-Length: 0

    ]]>
  </send>

  <!--
    Nothing is waited out here. The DUT registers as soon as its network is
    up, which is before its DSP reports ready. The call layer is wired at
    start-up, so a call offered inside that window is answered 503 with a
    Retry-After and not with a busy tone. The harness waits for the DSP over
    ubus before this scenario can reach the INVITE (run_e2e.sh daemon_start).
  -->

  <send retrans="500">
    <![CDATA[
      INVITE sip:5551000@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-uvoice-[pid]-cfu;rport
      From: SIPp <sip:sipp@[local_ip]:[local_port]>;tag=sipp-[pid]-cfu
      To: DUT <sip:5551000@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp call
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <recv response="100" optional="true"/>

  <!--
    The redirect, and the assertion that carries this flow: the Contact names
    the configured target at the account domain. A 180 here is an unexpected
    message and aborts the call, which is the "the line never rings" half.
  -->
  <recv response="302" timeout="15000">
    <action>
      <ereg regexp="&lt;sip:5552000@127\.0\.0\.1&gt;"
            search_in="hdr" header="Contact:" check_it="true"
            assign_to="fwd_contact"/>
    </action>
  </recv>

  <!-- the branch is the INVITE's, which is what a non-2xx ACK needs -->
  <send>
    <![CDATA[
      ACK sip:5551000@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-uvoice-[pid]-cfu;rport
      From: SIPp <sip:sipp@[local_ip]:[local_port]>;tag=sipp-[pid]-cfu
      To: DUT <sip:5551000@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Max-Forwards: 70
      Content-Length: 0

    ]]>
  </send>

  <Reference variables="fwd_contact"/>
</scenario>

<!--
  The twin of `uas_basic_call.xml` for the reliable transports: an outbound
  DUT call, a short wait, and a BYE from the DUT.

  It runs no `rtp_echo`, and that is the whole difference from
  `uas_basic_call.xml`. A TLS-enabled SIPp routes `rtp_echo` through its SRTP
  contexts, and ends a plain RTP run with EXIT_RTPCHECK_FAILED. A scenario
  that carries the action therefore cannot serve the tls twin. One file serves
  both twins instead, and the transport is the only thing that differs between
  the two runs. The media assertion moves to the harness, which reads the
  stream that the DUT programmed (`test/e2e/run_e2e.sh`, `media_port_wait`).

  `SIPP_TRANSPORT` supplies the transport, and the scenario needs a tcp or tls
  DUT. The harness reads the transport token of the Via and the transport
  parameter of the Contact off the SIPp message log. Reason: a SIPp regexp
  attribute takes no keyword, so it cannot name the transport that the run was
  given.

  RFC 3261 sections 13 and 15.
-->
<scenario name="UAS stream call with peer BYE">
  <!-- The DUT can register against this peer before its call, and a UAS run
       has one scenario for every request that reaches it. The first receive
       therefore takes the REGISTER too, and its branch answers 200 and ends
       (test/sipp/README.md, "The REGISTER branch"). -->
  <recv request="REGISTER|INVITE" regexp_match="true" timeout="60000" rrs="true"
        next="call" test="invite_seen">
    <action>
      <ereg regexp="^INVITE[[:space:]]" search_in="msg" assign_to="invite_seen"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:"
            assign_to="register_via,register_transport,register_sent_by,register_branch"/>
    </action>
  </recv>

  <send next="registered_done">
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$register_transport] [$register_sent_by];branch=[$register_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      [last_Expires:]
      Content-Length: 0

    ]]>
  </send>

  <label id="call"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP[media_ip_type] [media_ip]
      s=uvoice SIPp stream call
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000"/>

  <pause milliseconds="2000"/>

  <recv request="BYE" timeout="60000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>
  <label id="registered_done"/>
  <Reference variables="register_via"/>
</scenario>

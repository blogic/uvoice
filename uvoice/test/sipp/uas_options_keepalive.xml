<!--
  This peer answers the periodic OPTIONS keepalives of the DUT with 200.

  Each 200 carries `Allow` and `Accept` headers. The receive waits 120000 ms
  for each OPTIONS. `run_sipp.sh` sets the call count to 3 for this scenario
  alone (`-m 3`), so SIPp must complete three separate OPTIONS transactions.

  RFC 3261 section 11.
-->
<scenario name="UAS OPTIONS keepalive">
  <recv request="OPTIONS" timeout="120000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Allow: INVITE, ACK, CANCEL, BYE, OPTIONS
      Accept: application/sdp
      Content-Length: 0

    ]]>
  </send>
</scenario>

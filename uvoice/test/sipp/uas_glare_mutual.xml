<!--
  Mutual glare against the retry interval of a field switch: the DUT must
  answer the retry of this peer with 200, not 491.

  The DUT places the call and holds it, and this peer answers the hold
  re-INVITE 491. The DUT owns the Call-ID, so its own retry comes 2.1 to 4.0
  seconds later (RFC 3261 section 14.1). This peer retries after 1900 ms, as
  that switch does.

  The 200 to that re-INVITE is the whole assertion. RFC 3261 section 14.2 asks
  for a 491 only while an INVITE of this side is in progress. None is, because
  the leg waits out its own backoff. A 491 here leaves the switch with no
  retry at all, because the switch stops after one.

  This peer holds as well, so the answer of the DUT reads `a=recvonly` (RFC
  3264 section 8.4). The retry of the DUT behind it therefore reads
  `a=inactive`: the leg is held at both ends, and `sdp.c` writes `inactive`
  for that state.

  The 1900 ms is the value of the capture, and it leaves a budget of 200 ms.
  The exchange of this peer must reach its ACK before the 2100 ms floor of the
  retry. A late ACK leaves the leg inside that exchange when the retry timer
  fires.

  `glare_wait_fire()` in `call.c` then arms the wait again and does not retry.
  The retry comes one whole wait later, and the 2.1 to 4.0 second band of the
  flow refuses the run. An ACK held back 2500 ms measured 6.0 s. On a host
  where the budget does not hold, raise this pause, not the band.

  The end-to-end flow `glare-mutual` reads the delay of the retry off the
  capture (`test/e2e/run_e2e.sh`, `timing_491_check()`). Only an INVITE that
  the DUT sent counts there, so the re-INVITE of this peer at 1.9 s is not the
  one measured. `run_sipp.sh` applies the same timing check with tshark, so
  the scenario needs tcpdump and tshark.

  RFC 3261 sections 14.1, 14.2 and 15, RFC 3264 section 8.4.
-->
<scenario name="UAS mutual re-INVITE glare">
  <!-- The DUT can register against this peer before its call, and a UAS run
       has one scenario for every request that reaches it. The first receive
       therefore takes the REGISTER too, and its branch answers 200 and ends.
       The action list of that receive runs for the REGISTER as well, so it
       stores the values of the INVITE, and a later receive checks them
       (test/sipp/README.md, "The REGISTER branch"). -->
  <recv request="REGISTER|INVITE" regexp_match="true" timeout="60000" rrs="true"
        next="call" test="invite_seen">
    <action>
      <ereg regexp="^INVITE[[:space:]]" search_in="msg" assign_to="invite_seen"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:"
            assign_to="register_via,register_transport,register_sent_by,register_branch"/>
      <ereg regexp="From:[^&lt;]*&lt;([^&gt;]+)&gt;.*;tag=([^;[:space:]]+)"
            search_in="msg"
            assign_to="from_match,remote_uri,remote_tag"/>
      <ereg regexp="To:[^&lt;]*&lt;([^&gt;]+)&gt;"
            search_in="msg"
            assign_to="to_match,local_uri"/>
    </action>
  </recv>

  <send next="registered_done">
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$register_transport] [$register_sent_by];branch=[$register_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      [last_Expires:]
      Content-Length: 0

    ]]>
  </send>

  <label id="call"/>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 1 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp mutual glare
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000">
    <action>
      <ereg regexp="." search_in="var" variable="from_match"
            check_it="true" assign_to="initial_check"/>
      <ereg regexp="." search_in="var" variable="to_match"
            check_it="true" assign_to="initial_check"/>
    </action>
  </recv>

  <recv request="INVITE" timeout="30000">
    <action>
      <ereg regexp="a=sendonly" search_in="body" check_it="true"
            assign_to="hold_offer"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 491 Request Pending
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK" timeout="10000"/>

  <pause milliseconds="1900"/>

  <!-- The retry of the switch, inside the backoff window of the DUT. -->
  <send retrans="500" start_txn="peerhold">
    <![CDATA[
      INVITE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <[$local_uri]>;tag=sipp-[pid]-[call_number]
      To: <[$remote_uri]>;tag=[$remote_tag]
      [last_Call-ID:]
      CSeq: 1 INVITE
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      [routes]
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 2 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp mutual glare
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
      a=sendonly
    ]]>
  </send>

  <recv response="200" response_txn="peerhold" timeout="10000" rrs="true">
    <action>
      <ereg regexp="a=recvonly" search_in="body" check_it="true"
            assign_to="glare_answer"/>
    </action>
  </recv>

  <send ack_txn="peerhold">
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <[$local_uri]>;tag=sipp-[pid]-[call_number]
      To: <[$remote_uri]>;tag=[$remote_tag]
      [last_Call-ID:]
      CSeq: 1 ACK
      Max-Forwards: 70
      [routes]
      Content-Length: 0

    ]]>
  </send>

  <!-- The retry of the DUT, which the timing reader of the flow measures. -->
  <recv request="INVITE" timeout="10000">
    <action>
      <ereg regexp="a=inactive" search_in="body" check_it="true"
            assign_to="retry_offer"/>
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 1 3 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp mutual glare retry
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
      a=recvonly
    ]]>
  </send>

  <recv request="ACK" timeout="10000"/>

  <send retrans="500">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <[$local_uri]>;tag=sipp-[pid]-[call_number]
      To: <[$remote_uri]>;tag=[$remote_tag]
      [last_Call-ID:]
      CSeq: 2 BYE
      Max-Forwards: 70
      [routes]
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" timeout="10000"/>
  <label id="registered_done"/>
  <Reference variables="register_via,initial_check,hold_offer,glare_answer,retry_offer"/>
</scenario>

<!--
  Places the inbound calls of a field sequence one after another, and requires
  a 180 within one second of each INVITE. Reason: the field caller gives up
  when a 100 brings no 180 for 6.4 s. The runner places fifty calls through
  one instance (`-m 50`), one at a time. The end-to-end flow reads the
  distance from the INVITE to the 180 of each call from the capture.

  The DUT answers the odd calls, and this peer cancels the even calls. A run
  therefore leaves the line through both endings, as the field sequence does.
  The capture holds a canceled call and a new offer behind it.

  An answered call ends at the subscriber, not here. The scenario waits for
  the BYE of the DUT and answers it 200. The handset is therefore back on the
  cradle before the call ends at this side, and the next offer cannot arrive
  before that. The other order, a BYE from this side after a talk pause, makes
  the release of the hook race that offer. The line is then still off hook
  when the offer arrives, and answers it 486.

  Somebody has to lift the handset of an odd call and put it back after the
  talk time. The end-to-end flow does both through the stub hook
  (`test/e2e/run_e2e.sh`, `inbound_churn_hook_drive`).

  The header set is the field block of `uac_verstat_call.xml`. It has a
  token request URI that names the subscriber, and a To with a header
  parameter and no angle brackets (RFC 3261 section 20.10). It has a Contact
  with no user part, two Supported headers, a Session-ID and a
  Session-Expires. It also has the field Allow list and the field offer.

  The From carries the number of the caller of that capture, without the
  verstat parameter. The scenario therefore defines no SIPp keyword. The
  parameter belongs to the verstat caller identity rule, which
  `uac_verstat_call.xml` already drives. A keyword here would make every
  runner of this file pass `-key` for a value that nothing reads.

  Each call carries a Session-ID of its own, 32 hexadecimal characters (RFC
  7989 section 8). SIPp writes `[pid]` and `[call_number]` with no width of
  its own (SIPp 3.7.3 `call.cpp`, the "%u" of `E_Message_Call_Number`). It
  renders a computed variable as an empty string (`variables.cpp`,
  `getString`). The leading nop therefore builds the value. It writes 32
  zeros, the pid and the call number into one variable. A regular expression
  then takes the last 32 digits of that string back out.

  The Via branch is a literal of the pid and the call number, as
  `uac_cancel.xml` writes it. Reason: the CANCEL must carry the branch of the
  INVITE that it cancels (RFC 3261 section 9.1), and SIPp 3.7.3 has no
  `cancel_txn` attribute.

  The scenario runs over UDP and carries no `rtp_echo`. An answered call lasts
  the talk time that the flow holds, 600 ms, and the flow reads nothing from
  the media. An echo endpoint would only add a failure of its own.
-->
<scenario name="UAC inbound churn, odd calls answered and even calls canceled">
  <nop>
    <action>
      <assignstr assign_to="session_pad"
                 value="00000000000000000000000000000000[pid][call_number]"/>
      <ereg regexp="[0-9]{32}$" search_in="var" variable="session_pad"
            assign_to="session_id"/>
    </action>
  </nop>

  <send retrans="500">
    <![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port];transport=UDP SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-uvoice-[pid]-[call_number];rport
      Contact: <sip:[local_ip]:[local_port];transport=udp>
      CSeq: 1 INVITE
      Content-Length: [len]
      Content-Type: application/sdp
      Call-ID: [call_id]
      From: "2015550123" <sip:2015550123@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: sip:[service]@[remote_ip]:[remote_port];transport=udp
      Session-ID: [$session_id]
      Max-Forwards: 45
      Session-Expires: 1800;refresher=uac
      Supported: 100rel
      Supported: timer
      Allow: INVITE, ACK, PRACK, CANCEL, BYE, REFER, NOTIFY, OPTIONS, MESSAGE, INFO, REGISTER, SUBSCRIBE

      v=0
      o=- 4086519302 1767225600 IN IP[media_ip_type] [media_ip]
      s=-
      e=unknown@invalid.net
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101 18
      a=silenceSupp:off - - - -
      a=sqn: 0
      a=cdsc:1 image udptl t38
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=rtpmap:18 G729/8000
      a=sendrecv
      a=ptime:20
    ]]>
  </send>

  <recv response="100" optional="true"/>

  <!-- The bound of the field case, and the branch of the run. A DUT that rings
       the phone must send the caller the 180 at once.

       The odd call numbers take the answered path below. SIPp expands
       [call_number] inside the value of an assignstr (3.7.3 call.cpp, the
       E_AT_ASSIGN_FROM_STRING arm runs it through createSendingMessage), so
       the number reaches a variable and the regular expression reads its last
       digit. The branch is on this receive and not on a nop behind it
       (test/sipp/README.md, "When a failed check is judged"). -->
  <recv response="180" timeout="1000" next="answered" test="call_is_odd">
    <action>
      <assignstr assign_to="call_index" value="[call_number]"/>
      <ereg regexp="[13579]$" search_in="var" variable="call_index"
            assign_to="call_is_odd"/>
    </action>
  </recv>

  <!-- The ring of a canceled call lasts as long as this pause, and the pause
       is the pace of the run as well. Three limits of the DUT bind it, in this
       order.

       An answered call holds its 2xx record until 64*T1 and a line holds eight
       of them (src/proto/sip/ua.h UA_ACCEPT_MAX), so two answered calls
       have to stand apart by more than an eighth of that window. The hook
       sequence of an answered call needs its ring, its talk time and its
       release inside the distance between two offers. Last, every call
       leaves a server transaction for timer J, 32 s by default (sip_timer_j,
       RFC 3261 17.2.2), against the 64 entries of the table
       (src/proto/sip/txn.h SIP_TXN_MAX); measured peak at this pace is 49
       of 64. -->
  <pause milliseconds="700"/>

  <send retrans="500">
    <![CDATA[
      CANCEL sip:[service]@[remote_ip]:[remote_port];transport=UDP SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-uvoice-[pid]-[call_number];rport
      From: "2015550123" <sip:2015550123@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: sip:[service]@[remote_ip]:[remote_port];transport=udp
      Call-ID: [call_id]
      CSeq: 1 CANCEL
      Max-Forwards: 45
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" timeout="5000"/>
  <recv response="487" timeout="5000"/>

  <send next="done">
    <![CDATA[
      ACK sip:[service]@[remote_ip]:[remote_port];transport=UDP SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-uvoice-[pid]-[call_number];rport
      From: "2015550123" <sip:2015550123@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: sip:[service]@[remote_ip]:[remote_port];transport=udp[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Max-Forwards: 45
      Content-Length: 0

    ]]>
  </send>

  <!-- The answered half. The end-to-end flow seizes the hook of the DUT while
       an odd call rings, so the 200 arrives behind the 180 (RFC 3261 sections
       13 and 14). The ACK of a 2xx is a transaction of its own and carries a
       branch of its own (RFC 3261 17.1.1.3).

       The subscriber then goes on hook and the DUT sends the BYE. The receive
       below waits 15 s for it, which covers the talk time the flow holds plus
       a slow host. -->
  <label id="answered"/>

  <recv response="200" timeout="5000" rrs="true"/>

  <send>
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-uvoice-[pid]-[call_number]-ack;rport
      From: "2015550123" <sip:2015550123@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: sip:[service]@[remote_ip]:[remote_port];transport=udp[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:[local_ip]:[local_port];transport=udp>
      Max-Forwards: 45
      [routes]
      Content-Length: 0

    ]]>
  </send>

  <recv request="BYE" timeout="15000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <label id="done"/>
</scenario>

<!--
  This peer answers an outbound conference leg, and every hold and resume
  re-INVITE, until the DUT ends the dialog.

  This peer reads each re-INVITE for `a=sendonly`. A hold offer gets a
  `recvonly` answer, and any other offer gets a `sendrecv` answer. The read
  chooses the answer and is no check.

  It is the outbound twin of `uac_conf_leg.xml`. The end-to-end flow
  `conf-split` uses it for the second call, which the DUT places.

  RFC 3261 sections 13 to 15, RFC 3264 section 8.4.
-->
<scenario name="UAS conference leg with repeated hold and resume answers">
  <!-- The DUT can register against this peer before its call, and a UAS run
       has one scenario for every request that reaches it. The first receive
       therefore takes the REGISTER too, and its branch answers 200 and ends
       (test/sipp/README.md, "The REGISTER branch"). -->
  <recv request="REGISTER|INVITE" regexp_match="true" timeout="60000" rrs="true"
        next="call" test="invite_seen">
    <action>
      <ereg regexp="^INVITE[[:space:]]" search_in="msg" assign_to="invite_seen"/>
      <ereg regexp="SIP/2.0/([^[:space:]]+)[[:space:]]+([^;[:space:]]+).*branch=([^;[:space:]]+)"
            search_in="hdr" header="Via:"
            assign_to="register_via,register_transport,register_sent_by,register_branch"/>
    </action>
  </recv>

  <send next="registered_done">
    <![CDATA[
      SIP/2.0 200 OK
      Via: SIP/2.0/[$register_transport] [$register_sent_by];branch=[$register_branch];received=[remote_host];rport=[remote_port]
      [last_From:]
      [last_To:];tag=sipp-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Contact:]
      [last_Expires:]
      Content-Length: 0

    ]]>
  </send>

  <label id="call"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=conf-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=conf-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 2 1 IN IP[local_ip_type] [local_ip]
      s=uvoice conference leg
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" timeout="10000"/>

  <label id="wait-request"/>
  <nop>
    <action>
      <assign assign_to="hold_offer" value="0"/>
    </action>
  </nop>
  <recv request="INVITE" optional="true" next="reinvite">
    <action>
      <ereg regexp="a=sendonly" search_in="body"
            assign_to="hold_offer"/>
    </action>
  </recv>
  <recv request="BYE" timeout="60000" next="bye"/>

  <label id="reinvite"/>
  <nop test="hold_offer" next="hold"/>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 2 3 IN IP[local_ip_type] [local_ip]
      s=uvoice conference resume
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=sendrecv
    ]]>
  </send>
  <recv request="ACK" timeout="10000"/>
  <nop next="wait-request"/>

  <label id="hold"/>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 2 2 IN IP[local_ip_type] [local_ip]
      s=uvoice conference hold
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=recvonly
    ]]>
  </send>
  <recv request="ACK" timeout="10000"/>
  <nop next="wait-request"/>

  <label id="bye"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <label id="registered_done"/>
  <Reference variables="register_via,hold_offer"/>
</scenario>

<!--
  The DUT is the target of a completed attended transfer: it must answer a
  Replaces INVITE with no 180, and end the replaced dialog.

  The DUT places an ordinary call, which the out-of-call peer
  `xfer_peer_ooc.xml` answers (`SIPP_OOC_SCENARIO`, `SIPP_SERVICE` 5551000).
  After a 10000 ms pause for that setup, this scenario places a second call
  whose Replaces header names the first dialog.

  The dialog identity crosses between the two scenarios in the SIPp global
  variables `g_callid` and `g_dut_tag`. The out-of-call peer reads the Call-ID
  and the DUT's own tag from the INVITE that it answered. This scenario builds
  the Replaces header from them. The INVITE carries `Supported: timer,
  replaces`, `Require: replaces` and `Replaces:
  [g_callid];to-tag=[g_dut_tag];from-tag=sipp-peer-tag`. The peer tag is a
  fixed string, because an instance number cannot be predicted.

  The orientation is the receiver's (RFC 3891 section 3). The to-tag is the
  tag of the party that receives the request, which is the DUT's own tag in
  the replaced dialog. The from-tag is the peer's.

  The scenario takes only a 200 for the replacing INVITE, after an optional
  100. A DUT that rang the subscriber first would send a 180, and SIPp aborts
  the call on it. That is the "answer, do not ring" rule of the target role.
  The scenario then receives the BYE that the subscriber hook triggers, and
  answers it 200.

  The scenario carries no `rtp_echo`, by the stream-scenario rule of
  `test/e2e/README.md`. RFC 3891.
-->
<scenario name="UAC Replaces, the DUT answers the replacement and ends the replaced call">
  <Global variables="g_callid,g_dut_tag"/>

  <!-- The replaced call comes first. The DUT places it and the out-of-call
       peer answers it, which is what fills the two variables below; this pause
       is the window that call is set up in. -->
  <pause milliseconds="10000"/>

  <send retrans="500" start_txn="invite">
    <![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch];rport
      From: SIPp <sip:sipp@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: DUT <sip:[service]@[remote_ip]:[remote_port]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      Supported: timer, replaces
      Require: replaces
      Replaces: [$g_callid];to-tag=[$g_dut_tag];from-tag=sipp-peer-tag
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp 3 1 IN IP[local_ip_type] [local_ip]
      s=uvoice SIPp call
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=sendrecv
    ]]>
  </send>

  <recv response="100" response_txn="invite" optional="true"/>
  <recv response="200" response_txn="invite" timeout="20000" rrs="true"/>

  <send ack_txn="invite">
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: SIPp <sip:sipp@[local_ip]:[local_port]>;tag=sipp-[pid]-[call_number]
      To: DUT <sip:[service]@[remote_ip]:[remote_port]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      [routes]
      Content-Length: 0

    ]]>
  </send>

  <!-- The subscriber's hook ends the call the replacement now is. -->
  <recv request="BYE" timeout="60000"/>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>
</scenario>
